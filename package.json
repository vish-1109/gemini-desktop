{
  "name": "gemini-desktop",
  "productName": "Gemini",
  "desktopName": "io.github.vish1109.gemini.desktop",
  "version": "1.0.0",
  "description": "Desktop client for Google Gemini providing a native desktop experience on Linux.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "start:tray": "electron . --tray",
    "toggle": "electron . --toggle",
    "test": "node --test test/unit/*.test.js",
    "test:integration": "node test/integration/electronSmoke.test.js",
    "test:all": "npm test && npm run test:integration",
    "check": "node scripts/check-repo.js",
    "build": "electron-builder --linux --publish never",
    "build:deb": "electron-builder --linux deb --publish never",
    "build:appimage": "electron-builder --linux AppImage --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vish-1109/gemini-desktop.git"
  },
  "author": "Vishrut <vishrutgundaji@gmail.com>",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/vish-1109/gemini-desktop/issues"
  },
  "homepage": "https://github.com/vish-1109/gemini-desktop",
  "devDependencies": {
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0"
  },
  "build": {
    "appId": "io.github.vish1109.gemini",
    "productName": "Gemini",
    "executableName": "gemini-desktop",
    "asar": true,
    "icon": "icon.png",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "icon.png",
      "package.json",
      "LICENSE",
      "!**/.*"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "syncDesktopName": true,
      "synopsis": "Desktop client for Google Gemini",
      "category": "Utility;Network;",
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Gemini",
          "Comment": "Desktop client for Google Gemini",
          "Keywords": "AI;Gemini;Google;Chat;Assistant;"
        }
      }
    },
    "deb": {
      "packageName": "gemini-desktop",
      "afterRemove": "scripts/after-remove.tpl",
      "fpm": [
        "build/metainfo/io.github.vish1109.gemini.metainfo.xml=/usr/share/metainfo/io.github.vish1109.gemini.metainfo.xml",
        "build/deb/copyright=/usr/share/doc/gemini-desktop/copyright"
      ],
      "depends": [
        "libgtk-3-0t64 | libgtk-3-0",
        "libasound2t64 | libasound2",
        "libatspi2.0-0t64 | libatspi2.0-0",
        "libgbm1",
        "libnss3",
        "libnotify4",
        "libxtst6",
        "libxss1",
        "libuuid1",
        "libsecret-1-0",
        "xdg-utils"
      ],
      "recommends": [
        "libayatana-appindicator3-1 | libappindicator3-1"
      ]
    },
    "appImage": {
      "artifactName": "${name}-${version}-${arch}.${ext}"
    }
  }
}
